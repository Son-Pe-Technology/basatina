rules_version = '2';
// Reglas de seguridad de la Comunidad de avisos de BasatiNA (proyecto basatina-9a8b5).
// Se copian en Firebase → Firestore → Reglas → Publicar. Todo lo que no se permite aquí, está prohibido.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ayudas ----------
    // administradores: la cuenta compartida de administración y, desde el 24 nov. 2026, las cuentas
    // de Pedro y Sonia (súper administradores, con el correo confirmado). Mismos correos que SA_MAILS en web/superadmin.js.
    // Lo que solo leen ellos (p. ej. admin/llaves, la llave de GitHub) queda protegido por la regla «pueden todo».
    function esAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && (request.auth.token.email == 'administracion@sonpe-technology.es'
            || (request.auth.token.email in ['pedro@sonpe-technology.es', 'sonia@sonpe-technology.es']
                && request.auth.token.email_verified == true));
    }
    // cada móvil entra como usuario anónimo (su uid es el «código de colaborador»)
    // o con su cuenta de correo y contraseña (nov. 2026)
    function usuario() { return request.auth != null; }
    // cuenta de verdad: con correo y correo ya confirmado (los anónimos no tienen correo)
    function conCorreo() { return request.auth != null && request.auth.token.email is string; }
    function cuenta() { return conCorreo() && request.auth.token.email_verified == true; }
    // apodo: 3 a 20 letras, números, punto, guion o guion bajo; sin nombres que parezcan oficiales
    function apodoOk(a, k) {
      return a is string && a.matches('[\\p{L}0-9_.-]{3,20}') && k == a.lower()
        && !k.matches('.*(basatina|admin|moderad|oficial|sonpe|policia|guardiacivil|sos112|112).*');
    }
    function perfil() { return get(doc('usuarios', request.auth.uid)).data; }
    function doc(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function bloqueado() { return exists(/databases/$(database)/documents/bloqueados/$(request.auth.uid)); }
    // horas que dura cada tipo de aviso (la caducidad se calcula con «creado» + estas horas)
    function horas() {
      return {'arbol': 72, 'desprendimiento': 72, 'camino': 72, 'lluvia': 6, 'crecida': 24,
              'animal': 6, 'accidente': 6, 'veneno': 168, 'otro': 24};
    }
    // tipos que siempre revisa un administrador antes de publicarse
    function conRevision() { return ['accidente', 'veneno', 'otro']; }
    // dentro de Navarra (un poco de margen)
    function enNavarra(d) {
      return d.lat is number && d.lon is number
        && d.lat > 41.85 && d.lat < 43.35 && d.lon > -2.55 && d.lon < -0.70;
    }
    // textos que parecen llevar una matrícula, un teléfono o un correo → a revisión
    function textoDudoso(t) {
      return t.matches('(?s).*[0-9]{4}[ -]?[BCDFGHJKLMNPRSTVWXYZbcdfghjklmnprstvwxyz]{3}.*')
        || t.matches('(?s).*([0-9][ .-]?){9}.*')
        || t.matches('(?s).*@.*');
    }

    // ---------- administradores: pueden todo ----------
    match /{todo=**} {
      allow read, write: if esAdmin();
    }

    // ---------- 🔑 claves de servicios (24 nov. 2026) ----------
    // claves/app: AEMET, TomTom, Pl@ntNet, Rainbow y Web3Forms. Antes estaban en config/*.json de GitHub (público).
    // Las lee cualquier móvil que haya entrado en Firebase (también los anónimos); escribir, solo administradores (regla de arriba).
    match /claves/{d} {
      allow get: if usuario();
    }

    // ---------- avisos (lo que ve la gente) ----------
    match /avisos/{id} {
      // lista pública: solo publicados (la app pide where estado == 'publicado')
      allow list: if resource.data.estado == 'publicado';
      // uno suelto: publicados, o el tuyo propio para ver si está pendiente o retirado («Mis avisos»)
      allow get: if resource.data.estado == 'publicado'
        || (usuario() && get(doc('avisos_priv', id)).data.autor == request.auth.uid);

      // solo con cuenta confirmada; el aviso lleva el apodo de su perfil
      allow create: if cuenta() && !bloqueado()
        && request.resource.data.keys().hasOnly(['tipo', 'texto', 'lat', 'lon', 'creado', 'estado', 'si', 'no', 'ah', 'apodo'])
        && request.resource.data.keys().hasAll(['tipo', 'texto', 'lat', 'lon', 'creado', 'estado', 'si', 'no', 'ah', 'apodo'])
        && request.resource.data.apodo == perfil().apodo
        && request.resource.data.tipo in horas()
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 300
        && enNavarra(request.resource.data)
        && request.resource.data.creado == request.time
        && request.resource.data.si == 0 && request.resource.data.no == 0
        // marca anónima del autor (para que cada uno pueda ocultar en su móvil los avisos de un colaborador)
        && request.resource.data.ah is string && request.resource.data.ah.size() == 12
        && (request.resource.data.estado == 'pendiente'
            || (request.resource.data.estado == 'publicado'
                && !(request.resource.data.tipo in conRevision())
                && !textoDudoso(request.resource.data.texto)))
        // se crea a la vez que su ficha privada (con el autor) y que el control de «un aviso cada 2 minutos»
        && getAfter(doc('avisos_priv', id)).data.autor == request.auth.uid
        && getAfter(doc('limites', request.auth.uid)).data.ultimo == request.time;

      // votos «sigue ahí» (si) / «ya no está» (no): +1, una sola vez por cuenta
      allow update: if cuenta() && !bloqueado()
        && resource.data.estado == 'publicado' && request.time < resource.data.creado + duration.value(horas()[resource.data.tipo], 'h')
        && !exists(doc('votos', id + '_' + request.auth.uid))
        && getAfter(doc('votos', id + '_' + request.auth.uid)).data.v in ['si', 'no']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([getAfter(doc('votos', id + '_' + request.auth.uid)).data.v])
        && request.resource.data[getAfter(doc('votos', id + '_' + request.auth.uid)).data.v]
             == resource.data[getAfter(doc('votos', id + '_' + request.auth.uid)).data.v] + 1;

      // el autor puede borrar su aviso cuando quiera (junto con su ficha privada)
      allow delete: if usuario() && get(doc('avisos_priv', id)).data.autor == request.auth.uid;
    }

    // ---------- ficha privada del aviso: quién lo envió (solo administradores y el propio autor) ----------
    match /avisos_priv/{id} {
      allow get: if usuario() && resource.data.autor == request.auth.uid;
      // «mis avisos» de la cuenta (la consulta tiene que filtrar por autor == mi uid)
      allow list: if usuario() && resource.data.autor == request.auth.uid;
      allow delete: if usuario() && resource.data.autor == request.auth.uid && !existsAfter(doc('avisos', id));
      allow create: if cuenta() && !bloqueado()
        && request.resource.data.keys().hasOnly(['autor'])
        && request.resource.data.autor == request.auth.uid
        && existsAfter(doc('avisos', id));
    }

    // ---------- control antispam: como mucho un aviso cada 2 minutos por móvil ----------
    match /limites/{uid} {
      allow get: if usuario() && request.auth.uid == uid;
      allow create: if usuario() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == request.time;
      allow update: if usuario() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == request.time
        && request.time > resource.data.ultimo + duration.value(2, 'm');
      allow delete: if usuario() && request.auth.uid == uid;
    }

    // ---------- votos: uno por aviso y móvil (id = idAviso_uid) ----------
    match /votos/{vid} {
      allow get: if usuario() && vid.matches('.*_' + request.auth.uid);
      allow create: if cuenta() && !bloqueado()
        && request.resource.data.keys().hasOnly(['aviso', 'v'])
        && request.resource.data.v in ['si', 'no']
        && vid == request.resource.data.aviso + '_' + request.auth.uid;
    }

    // ---------- denuncias 🚩: las crea cualquiera, solo las leen los administradores ----------
    match /denuncias/{d} {
      allow create: if usuario() && !bloqueado()
        && request.resource.data.keys().hasOnly(['aviso', 'motivo', 'texto', 'creado', 'autor'])
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.creado == request.time
        && request.resource.data.motivo in ['datos', 'acusa', 'falso', 'ofensivo', 'ilegal', 'yano', 'otro']
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 300
        && exists(doc('avisos', request.resource.data.aviso));
    }

    // ---------- cuentas (nov. 2026) ----------
    // perfil: solo lo ve su dueño. El apodo se copia en cada aviso, que es lo único público.
    match /usuarios/{uid} {
      allow get: if usuario() && request.auth.uid == uid;
      allow create: if conCorreo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['apodo', 'apodoK', 'creado', 'cambiado', 'normas'])
        && apodoOk(request.resource.data.apodo, request.resource.data.apodoK)
        && request.resource.data.creado == request.time && request.resource.data.cambiado == request.time
        && request.resource.data.normas is int
        && getAfter(doc('apodos', request.resource.data.apodoK)).data.uid == uid;
      // cambiar el apodo: como mucho una vez al día
      // («quitado» lo pone un administrador cuando cambia un apodo ofensivo)
      allow update: if conCorreo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['apodo', 'apodoK', 'creado', 'cambiado', 'normas', 'quitado'])
        && request.resource.data.creado == resource.data.creado
        && apodoOk(request.resource.data.apodo, request.resource.data.apodoK)
        && request.resource.data.normas is int
        && ((request.resource.data.apodoK == resource.data.apodoK && request.resource.data.cambiado == resource.data.cambiado)
            || (request.resource.data.cambiado == request.time
                && request.time > resource.data.cambiado + duration.value(1, 'd')
                && getAfter(doc('apodos', request.resource.data.apodoK)).data.uid == uid));
      allow delete: if usuario() && request.auth.uid == uid;
    }
    // reserva de apodos (para que no haya dos iguales). Cualquiera puede mirar si uno está libre.
    match /apodos/{k} {
      allow get: if true;
      allow create: if conCorreo()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(doc('usuarios', request.auth.uid)).data.apodoK == k;
      allow delete: if usuario() && resource.data.uid == request.auth.uid
        && (!existsAfter(doc('usuarios', request.auth.uid)) || getAfter(doc('usuarios', request.auth.uid)).data.apodoK != k);
    }
    // Mi Espacio guardado en la cuenta: solo su dueño
    match /espacio/{uid} {
      allow get, delete: if usuario() && request.auth.uid == uid;
      allow create, update: if cuenta() && request.auth.uid == uid;
    }

    // ---------- 📊 contador anónimo de uso (16 nov. 2026) ----------
    // estadisticas/AAAA-MM-DD y estadisticas/AAAA-MM: cada móvil suma +1 al día y al mes. Sin identificadores y sin
    // necesidad de entrar (request.auth puede ser nulo). Solo se puede sumar 1 a cada campo, en el día o mes actual.
    // Leer: solo administradores (regla de arriba).
    function campoUso() { return ['activos', 'app', 'web', 'nuevos']; }
    function fechaOk(d) {
      return (d.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
              && request.time > timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) - duration.value(1, 'd')
              && request.time < timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) + duration.value(2, 'd'))
        || (d.matches('20[0-9]{2}-[0-9]{2}')
              && request.time > timestamp.date(int(d[0:4]), int(d[5:7]), 1) - duration.value(1, 'd')
              && request.time < timestamp.date(int(d[0:4]), int(d[5:7]), 1) + duration.value(33, 'd'));
    }
    function mas1(k) {
      return !(k in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
        || request.resource.data[k] == (resource == null ? 0 : resource.data.get(k, 0)) + 1;
    }
    match /estadisticas/{d} {
      allow create, update: if fechaOk(d)
        && request.resource.data.keys().hasOnly(campoUso())
        && mas1('activos') && mas1('app') && mas1('web') && mas1('nuevos');
    }

    // ---------- 🏆 clasificación de los juegos (21 nov. 2026) ----------
    // clasif/{uid}: puntos de cada juego de quien tiene cuenta confirmada y quiere salir en la clasificación.
    // Público: el apodo y los puntos. Solo el dueño escribe; el apodo tiene que ser el suyo.
    // Para que no se puedan inventar puntos de golpe: como mucho una escritura cada 15 s, los niveles suben de 1 en 1
    // y cada juego suma como mucho 300 puntos por nivel alcanzado + 1000.
    function cJ() { return ['sopa', 'sudoku', 'cruci']; }
    function cNum(d, k, max) { return d[k] is int && d[k] >= 0 && d[k] <= max; }
    function cBien(d) {
      return d.keys().hasOnly(['apodo', 'apodoK', 'sopa', 'sudoku', 'cruci', 'total', 'nsopa', 'nsudoku', 'ncruci', 't'])
        && d.apodoK == perfil().apodoK && d.apodo == perfil().apodo
        && cNum(d, 'sopa', 10000000) && cNum(d, 'sudoku', 10000000) && cNum(d, 'cruci', 10000000)
        && cNum(d, 'nsopa', 5000) && cNum(d, 'nsudoku', 5000) && cNum(d, 'ncruci', 5000)
        && d.total == d.sopa + d.sudoku + d.cruci && d.t == request.time;
    }
    function cSube(d, o, j) {
      return d['n' + j] >= o['n' + j] && d['n' + j] <= o['n' + j] + 1
        && d[j] >= o[j] && d[j] <= o[j] + 300 * d['n' + j] + 1000;
    }
    match /clasif/{uid} {
      allow get, list: if true;
      allow create: if cuenta() && request.auth.uid == uid && cBien(request.resource.data)
        && request.resource.data.total <= 30000;
      allow update: if cuenta() && request.auth.uid == uid && cBien(request.resource.data)
        && request.time > resource.data.t + duration.value(15, 's')
        && cSube(request.resource.data, resource.data, 'sopa')
        && cSube(request.resource.data, resource.data, 'sudoku')
        && cSube(request.resource.data, resource.data, 'cruci');
      allow delete: if usuario() && request.auth.uid == uid;
    }

    // ---------- bloqueados: solo administradores (regla de arriba) ----------
  }
}
